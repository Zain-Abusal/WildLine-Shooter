# Optional public client configuration; never put credentials in VITE_ variables.
# Leave VITE_MULTIPLAYER_URL empty to use browser-hosted (P2P) matches via /api/signal.
# Set it only to use the optional dedicated server (npm run multiplayer), e.g. ws://localhost:8787.
VITE_MULTIPLAYER_URL=
# Optional TURN relay for players on strict networks (a service outside Vercel).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# Server-side (Vercel Function): added automatically when a Redis database is connected in Vercel Storage.
# Either REDIS_URL (redis:// or rediss://) or the Upstash REST pair below.
# REDIS_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
